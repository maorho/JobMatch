# JobMatch environment template. Copy to .env.local for development; set the
# same keys in Vercel (Settings → Environment Variables) for preview/production.
# The contract is enforced by src/app/lib/env.ts at boot: production refuses to
# start only when a REQUIRED key below is missing/invalid. Everything else is
# optional: a missing partner key or a malformed value logs a "⚠️ env:" warning,
# the value is ignored and that feature switches itself off. Empty values
# (KEY=) count as unset. Never commit real values.

# ============================================================================
# REQUIRED (everywhere; production additionally enforces the notes in brackets)
# ============================================================================
# MongoDB Atlas connection string (MONGODB_URI is accepted as an alias).
MONGO_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/jobmatch?retryWrites=true&w=majority
# Session JWT signing key, 16+ chars (32+ recommended): openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Shared secret for cron/admin routes (?cron_secret= or Authorization: Bearer). [production: 32+ chars]
CRON_SECRET=replace-with-openssl-rand-hex-32-output-xxxxxxxxxxxxxxx
# Public origin, no trailing slash. [production: required, must be https://]
# Used for OAuth redirect URIs, canonical URLs, the sitemap, emails and webhooks.
# Vercel Preview deployments may leave it unset: https://$VERCEL_BRANCH_URL (else
# https://$VERCEL_URL), both injected by Vercel, is used instead.
APP_URL=https://job-match-six.vercel.app
# Optional client-side twin of APP_URL (only if a client component needs the origin).
# NEXT_PUBLIC_APP_URL=https://job-match-six.vercel.app

# ============================================================================
# CORE SERVICES (optional, but the product is thin without them)
# ============================================================================
# Embeddings + every LLM feature (matcher, résumé chat, interviews, agents). Without it the feed is recency-only.
OPENAI_API_KEY=sk-...
# Atlas Search: "0" forces the in-process fallback instead of $vectorSearch/$search.
# ATLAS_SEARCH=1
# "1" moves the active-jobs filter into the Atlas $vectorSearch/$search stage. Set it only AFTER adding
# `active` as a filter field to both the job_vectors and job_text Atlas indexes (see DEPLOY.md §2).
# ATLAS_FILTER_ACTIVE=1
# Agent bus: "0" stops ticks from running inline after a trigger (cron-only mode).
# AGENTS_INLINE=1
# Model-name overrides (defaults live next to each caller).
# OPENAI_REALTIME_MODEL=gpt-realtime-mini
# OPENAI_REALTIME_VOICE=marin
# PRACTICE_MODEL=gpt-4o-mini
# WEB_QUESTIONS_MODEL=gpt-4o-mini
# COMPANY_RESEARCH_MODEL=gpt-4o-mini
# COMPANY_PROFILE_MODEL=gpt-4o-mini
# APPLY_AGENT_MODEL=gpt-4o

# --- Puppeteer render/capture server (ATS detection, captures, auto-apply) ---
# Separate host running `npm run puppeteer-server` (see DEPLOY.md). Without it auto-apply is off.
# PUPPETEER_SERVER_URL=https://apply.example.com
# Shared bearer token between the app and that server. [production: without it auto-apply stays off]
# SCRAPER_TOKEN=replace-with-openssl-rand-hex-32-output
# Puppeteer-server side only:
# SCRAPER_ALLOWED_ORIGIN=https://job-match-six.vercel.app
# SCRAPER_CONCURRENCY=3
# Background worker (`npm run worker`): run budget / idle poll, milliseconds.
# WORKER_BUDGET_MS=600000
# WORKER_IDLE_MS=15000

# --- Résumé file storage (S3). REGION + KEY ID + SECRET together (a partial set only warns; uploads fail) ---
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# S3_BUCKET_NAME=jobmatch-resumes

# --- Job search enrichment (SerpApi; note the underscore) ---
# SERPAPI_KEY=...

# ============================================================================
# AUTH + INTEGRATIONS
# ============================================================================
# Google social login + Gmail application tracking. ID and SECRET together.
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# Seals Gmail refresh tokens (AES-256-GCM). Without it Gmail tracking stays off (Google sign-in still works). openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-output
# Facebook login. ID and SECRET together.
# FACEBOOK_APP_ID=...
# FACEBOOK_APP_SECRET=...

# --- Outbound email (password reset, notifications, contact relay) ---
# Either Resend...
# RESEND_API_KEY=re_...
# ...or SMTP. Gmail: smtp.gmail.com, port 465, SMTP_USER = the Gmail address, SMTP_PASS = an App Password
# (Google Account → Security → App passwords), EMAIL_FROM = the same address. Leave SMTP_SECURE unset:
# TLS is on for port 465 and STARTTLS for 587 automatically ("1"/"true" or "0"/"false" overrides).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_SECURE=
# Sender address. Without it mail goes out from a fallback sender (a warning at boot).
# EMAIL_FROM=JobMatch <you@gmail.com>
# Contact form: where messages go / what they are sent from.
# CONTACT_TO_EMAIL=hello@example.com
# CONTACT_FROM_EMAIL=JobMatch <no-reply@example.com>
# Ops alerts (quota exhaustion, agent failures).
# ALERT_EMAIL=ops@example.com

# --- Messaging channels ---
# WhatsApp Cloud API. APP_SECRET verifies webhook signatures (without it the webhook answers 503).
# WHATSAPP_TOKEN=EAAB...
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_DISPLAY_NUMBER=+972501234567
# WHATSAPP_VERIFY_TOKEN=replace-with-random-8-plus-chars
# WHATSAPP_APP_SECRET=meta-app-secret
# Telegram bot. WEBHOOK_SECRET is echoed back by Telegram on every update (without it the webhook answers 503).
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_BOT_USERNAME=JobMatchBot
# TELEGRAM_WEBHOOK_SECRET=replace-with-random-8-plus-chars

# --- Phone interviews (Twilio + the voice bridge; FEATURE_PHONE=1 to enable) ---
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+972501234567
# PHONE_BRIDGE_WSS_URL=wss://apply.example.com

# --- Legacy external-jobs Google Sheet (CSV export URL). Skipped when unset ---
# NEXT_PUBLIC_CSV_URL=https://docs.google.com/spreadsheets/d/.../export?format=csv

# ============================================================================
# FEATURE FLAGS + QUOTAS ("1"/"true" on, "0"/"false" off; unset = default)
# ============================================================================
# Phone interviews: default off until tested on real calls.
# FEATURE_PHONE=0
# Auto-apply: default on only when the apply server is configured (PUPPETEER_SERVER_URL, plus SCRAPER_TOKEN
# in production). "0" turns it off everywhere; "1" cannot switch it on in production without that server.
# The UI reads the state from GET /api/settings/auto-apply (`available`), so there is no client-side twin.
# FEATURE_AUTO_APPLY=1
# Personal MCP keys: default on.
# FEATURE_MCP=1
# Per-user daily caps on paid actions (override DEFAULT_LIMITS in lib/ops/quota.ts).
# QUOTA_VOICE_SESSION=10
# QUOTA_PHONE_SESSION=3
# QUOTA_AUTO_APPLY=20
# QUOTA_TAILOR=30
# QUOTA_PRACTICE_GRADE=50
# QUOTA_ENFORCE_IN_TESTS=0
