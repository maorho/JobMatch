{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": "..",
    "paths": { "@/*": ["./src/*"] },
    "jsx": "preserve",
    "resolveJsonModule": true,
    "noEmit": true
  },
  "ts-node": { "transpileOnly": true, "files": true },
  "include": ["./worker.ts", "../src/app/lib/**/*.ts", "../src/app/models/**/*.ts"]
}
