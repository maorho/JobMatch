{
  "name": "jobsearch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "puppeteer-server": "ts-node --project ./server/tsconfig.server.json ./server/index.ts",
    "worker": "ts-node -r tsconfig-paths/register --project ./server/tsconfig.worker.json ./server/worker.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"tests/scale/**\"",
    "test:watch": "vitest",
    "test:scale": "vitest run tests/scale --testTimeout=600000",
    "eval": "vitest run --config vitest.evals.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.804.0",
    "@aws-sdk/s3-request-presigner": "^3.804.0",
    "@langchain/core": "^0.3.80",
    "@langchain/openai": "^0.5.13",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/cors": "^2.8.19",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "framer-motion": "^12.9.4",
    "jose": "^6.1.0",
    "lucide-react": "^0.553.0",
    "mongoose": "^8.24.5",
    "next": "^16.4.0",
    "nodemailer": "^10.1.1",
    "openai": "^5.5.1",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.43.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "swr": "^2.3.3",
    "unpdf": "^1.7.0",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/formidable": "^3.4.5",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.19.27",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "mongodb-memory-server": "^10.4.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
